generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  steam_id  String   @id @unique
  currency  Int      @default(0)
  heroes    Json     @default("{}")
  items     Json     @default("{}")
  createdAt DateTime @default(now())

  participations MatchParticipation[]
}

model Match {
  id               Int                  @id @default(autoincrement())
  difficulty       String
  wavesCleared     Int                  @default(0)
  createdAt        DateTime             @default(now())
  isWin            Boolean              @default(false)
  heroes           String[]             @default([])
  wagerTotal       Int                  @default(0)
  wagerMultiplier  Float                @default(1.0)

  participations MatchParticipation[]
}

model Hero {
  name           String               @id
  participations MatchParticipation[]
}

model MatchParticipation {
  player   Player @relation(fields: [playerId], references: [steam_id])
  playerId String

  match   Match @relation(fields: [matchId], references: [id])
  matchId Int

  hero     Hero   @relation(fields: [heroName], references: [name])
  heroName String

  @@id([playerId, matchId])
}
