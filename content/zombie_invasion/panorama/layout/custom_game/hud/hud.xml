<root>
    <styles>
        <include src="file://{resources}/layout/custom_game/hud/hud.css"/>
    </styles>
    <scripts>
        <include src="file://{resources}/layout/custom_game/hud/hud.js"/>
    </scripts>

	<Panel hittest="false" class="root">
		<Panel id="QPanel" class="hide">
			<Panel id="QHead">
				<Label id="quest_name" class="qtext" text="sobaka"/>
			</Panel>
			<Panel id="QContent">
				<Panel id="QDesc">
					<Label id="quest_desc" class="qtext" text="sobaka idet gulyat s toboy"/>
				</Panel>
				<Panel id="QReward">
					<Panel id="quest-panel-items" lass="qrewardpanel">
						<Panel id="quest-panel-item-current" class="quest-panel-down">
							<Label class="qtext" text="НУЖНО:"/>
							<DOTAItemImage id="quest_item-current" class="quest-items" itemname="item_meat">
								<Label id="quest_item-count" text="2"/>
							</DOTAItemImage>
						</Panel>
						<Panel class="quest-panel-down">
							<Label class="qtext" text="НАГРАДА:"/>
							<DOTAItemImage id="quest_item-reward" class="quest-items" itemname="item_meat"/>
						</Panel>
					</Panel>
					<Panel id="quest-panel-exp" class="qrewardpanel">
						<Label id="quest_gold" class="qtext" text="dadut gold: 10"/>
						<Label id="quest_exp" class="qtext" text="dadut exp: 10"/>
					</Panel>
				</Panel>
			</Panel>
			<Panel id="QFoot">
				<Button id="QClose" onactivate="CloseQuest();">
					<Label class="qtext" text="OK"/>
				</Button>
			</Panel>
		</Panel>
		
		<Button hittest="true" id="HTPBtn" onactivate="ToggleHTPPanel()" onmouseover="DOTAShowTextTooltip(#htpbtn)" onmouseout="DOTAHideTextTooltip();">
            <Label class="classText" text="?"/>
        </Button>
		
		<Panel id="HTPPanel" class="hide">
			<Panel id="GuideSelect">
		        <Button hittest="true" id="guide_basic" class="guideTopBtns" onactivate="BasicGuide()">
                    <Label id="basicguidebtn" class="classText guideText" text="#guide_basic"/>
                </Button>
				<Button hittest="true" id="guide_advanced" class="guideTopBtns" onactivate="AdvancedGuide()">
                    <Label id="advancedguidebtn" class="classText guideText" text="#guide_advanced"/>
                </Button>
			</Panel>
			<Panel id="pages">
			    <Panel id="basic1" class="guidePage hide">
				    <Label text="#basic1" class="guideHeader classText"/>
					<Label text="#basic1_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/basic1.png" class="guideImage"/>
			    </Panel>
				<Panel id="basic2" class="guidePage hide">
				    <Label text="#basic2" class="guideHeader classText"/>
					<Label text="#basic2_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/basic2.png" class="guideImage"/>
			    </Panel>
				<Panel id="basic3" class="guidePage hide">
				    <Label text="#basic3" class="guideHeader classText"/>
					<Label text="#basic3_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/basic3.png" class="guideImage"/>
			    </Panel>			

			    <Panel id="advanced1" class="guidePage hide">
				    <Label text="#advanced1" class="guideHeader classText"/>
					<Label text="#advanced1_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/advanced1.png" class="guideImage"/>
			    </Panel>
				<Panel id="advanced2" class="guidePage hide">
				    <Label text="#advanced2" class="guideHeader classText"/>
					<Label text="#advanced2_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/advanced2.png" class="guideImage"/>
			    </Panel>
				<Panel id="advanced3" class="guidePage hide">
				    <Label text="#advanced3" class="guideHeader classText"/>
					<Label text="#advanced3_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/advanced3.png" class="guideImage"/>
			    </Panel>
			    <Panel id="advanced4" class="guidePage hide">
				    <Label text="#advanced4" class="guideHeader classText"/>
					<Label text="#advanced4_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/advanced4.png" class="guideImage"/>
			    </Panel>
			    <Panel id="advanced5" class="guidePage hide">
				    <Label text="#advanced5" class="guideHeader classText"/>
					<Label text="#advanced5_text" class="guidePageText"/>
					<Image src="file://{images}/custom_game/guide/advanced5.png" class="guideImage"/>
			    </Panel>
			</Panel>
			
			<Panel id="pagesBtns">
			    <Button class="pagesBtn" onactivate="GuidePreviousPage()">
				    <Label text="#previous" class="classText guideText" />
				</Button>
				<Label id="PageNumb" class="classText" text="0/0"/>
				<Button class="pagesBtn" onactivate="GuideNextPage()">
				    <Label text="#next" class="classText guideText" />
				</Button>
			</Panel>
		</Panel>
	</Panel>
</root>